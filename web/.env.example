# --- Supabase（SETUP.md の手順で作成） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー側だけで使う。ブラウザや拡張には絶対に置かない
SUPABASE_SERVICE_ROLE_KEY=

# --- 認証 ---
# Web 画面にログインできるメールアドレス（Supabase Auth のユーザー）
LIFEOS_OWNER_EMAIL=
# 拡張・iPhone ショートカット用の個人用トークン（長いランダム文字列。例: openssl rand -hex 32）
LIFEOS_API_TOKEN=

# --- 任意 ---
# 起床時刻（「今寝れば◯時間◯分」の計算用）
LIFEOS_WAKE_TIME=06:15
# 「夜」の集計を始める時刻
LIFEOS_NIGHT_AFTER=23:30
