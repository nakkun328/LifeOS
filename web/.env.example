# --- Supabase（SETUP.md の手順で作成） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー側だけで使う。ブラウザや拡張には絶対に置かない
SUPABASE_SERVICE_ROLE_KEY=

# --- 認証 ---
# Web 画面にログインできるメールアドレス（Supabase Auth のユーザー）
LIFEOS_OWNER_EMAIL=
# 拡張・iPhone ショートカット用の個人用トークン（長いランダム文字列。例: openssl rand -hex 32）
LIFEOS_API_TOKEN=

# iPhone ショートカット専用のトークン（任意）。20文字以上。睡眠とアプリ利用の送信だけに使える。
# 漏れても閲覧などには使えず、これだけ作り直せば済む。Mac がなくても iPhone だけで設定できる（docs/iphone-shortcuts.md）
LIFEOS_IPHONE_TOKEN=

# --- 任意 ---
# 「夜」の集計を始める時刻
LIFEOS_NIGHT_AFTER=23:30

# --- Discord（Phase 4。SETUP.md を参照） ---
# 署名検証用。Developer Portal の General Information → Public Key
DISCORD_PUBLIC_KEY=
# 操作を許可する自分の Discord ユーザーID（それ以外の人は何も実行できない）
DISCORD_OWNER_ID=
# 以下はコマンド登録スクリプトを手元で1回実行するときだけ使う（サーバーには置かない）
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
